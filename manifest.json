{
  "manifest_version": 3,
  "name": "Crawlcast",
  "version": "0.1.0",
  "description": "Detect and download HLS streams and direct MP4 video from the web.",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "downloads",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}